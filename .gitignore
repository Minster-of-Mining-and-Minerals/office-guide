# Node modules
/backend/node_modules/

# Environment variables
/backend/.env
# Root .env for docker-compose (contains secrets — do not commit)
/.env

# Windows reserved names (can't be checked in on Windows)
/nul
/frontend/nul

# Ignore uploads
/backend/uploads/
/backend/public/uploads/
/backend/tmp/
# Logs
logs/
*.log

# OS files
/backend/.DS_Store
/backend/Thumbs.db

# Build outputs
/backend/dist/
/backend/build/

# Impeccable — commit config.json, design.json, PRODUCT.md, DESIGN.md; ignore local session state
/.impeccable/live/sessions/
/.impeccable/live/cache/
/.impeccable/assets/