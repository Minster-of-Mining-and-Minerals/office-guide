# Browser-facing origin. Do not include a trailing slash.
PUBLIC_URL=http://localhost:3000
HTTP_PORT=3000
TZ=Africa/Addis_Ababa

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=digital_signage_db

# Replace both values with long random strings in production.
JWT_SECRET=change-this-jwt-secret-before-production
AUTH_SECRET=change-this-auth-secret-before-production
JWT_EXPIRES_IN=7d

# Initial account created by `docker compose exec backend npm run seed`.
# Change the password before seeding any shared or production environment.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PHONE=+251911000001
SEED_ADMIN_PASSWORD=password

# Optional email delivery
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
