# Minister Of Mines Office Guide — Root Environment
# Used by docker-compose.yml and injected into all services

# === Database ===
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=office_guide
DB_HOST=db
DB_PORT=5432
DB_DIALECT=postgres

# === Application URLs (deployed on server IP 10.0.71.213, port 8082) ===
APP_URL=http://10.0.71.213:8082
AUTH_URL=http://10.0.71.213:8082
FRONTEND_URL=http://10.0.71.213:8082
BASE_URL=http://10.0.71.213:8082
API_PUBLIC_URL=http://10.0.71.213:8082/api
BACKEND_PUBLIC_URL=http://10.0.71.213:8082
APP_DOMAIN=10.0.71.213
APP_TIMEZONE=Africa/Addis_Ababa

# === JWT ===
JWT_SECRET=thisisoursecretcodefortoken
JWT_EXPIRATION_TIME="12h"
JWT_EXPIRES_IN="7d"

# === Frontend Public URLs ===
NEXT_PUBLIC_BASE_URL=/api
NEXT_PUBLIC_FILE_URL=
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PORT=5001
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_DEPLOYMENT_MODE=nginx

# === NextAuth ===
AUTH_SECRET=your-random-secret-at-least-32-characters-long
NEXTAUTH_SECRET=your-random-secret-at-least-32-characters-long
AUTH_TRUST_HOST=true

# === NGINX Ports ===
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# === Behaviour ===
TRUST_PROXY=true
RUN_DB_MIGRATIONS=true
RUN_DB_SEEDERS=true

# === Email ===
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
