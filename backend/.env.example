PORT=4000
SOCKET_PORT=5000

JWT_SECRET=thisisoursecretcodefortoken
JWT_EXPIRATION_TIME="12h"
JWT_EXPIRES_IN="7d"

# ================== Database ==================
# NOTE: config/config.js reads DB_USERNAME (not DB_USER)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=digital_signage_db
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Some seeders / knexfile read DB_USER, keep both in sync
DB_USER=postgres

# ================== Frontend / URLs ==================
FRONTEND_URL="http://localhost:3000"
BASE_URL="http://localhost:4000"

# ================== Email ==================
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-app-password"
EMAIL_FROM="MoM Digital Signage <your-email@example.com>"

APP_NAME=MoM Digital Signage

# ================== Initial seed administrator ==================
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@gmail.com"
SEED_ADMIN_PHONE="+251911000001"
SEED_ADMIN_PASSWORD="password"

# ================== SMS / SMPP (optional) ==================
SMPP_HOST=
SMPP_PORT=
SMPP_SYSTEM_ID=
SMPP_PASSWORD=
SMPP_SOURCE_ADDR=

# ================== Tokens ==================
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
REFRESH_TOKEN_BYTES=64
